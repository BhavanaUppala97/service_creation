

# Terraform working directories
**/.terraform/*

# Local Terraform state
*.tfstate
*.tfstate.*

# Terraform variable files
*.tfvars
*.tfvars.json

# Terraform plans
*.tfplan
tfplan

# Crash logs
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Do not ignore .terraform.lock.hcl
